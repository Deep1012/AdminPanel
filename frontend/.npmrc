# react-day-picker@8.10.1 declares a peer of date-fns ^2 || ^3, while the
# project pins date-fns ^4. The project was originally installed with yarn,
# which only warns on peer conflicts, so package-lock.json was resolved
# tolerantly; strict npm refuses it with ERESOLVE. This makes npm resolve the
# same way, locally and in CI.
#
# react-day-picker is used only by the generated components/ui/calendar.jsx,
# which nothing imports. Removing both would let this file go away.
legacy-peer-deps=true
